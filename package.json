{
  "name": "pikapika-tab",
  "displayName": "PikaPika Tab",
  "version": "0.0.1",
  "description": "A pure New-Tab extension that could only customize backgrounds.",
  "author": "zthxxx",
  "repository": "zthxxx/pikapika-tab",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "plasmo dev",
    "lint": "TIMING=1 eslint --format codeframe .",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,mts,tsx}": [
      "eslint --format codeframe"
    ]
  },
  "dependencies": {
    "localforage": "^1.10.0",
    "plasmo": "0.90.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "3.4.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "4.1.1",
    "@antfu/eslint-config-react": "0.39.7",
    "@stylistic/eslint-plugin": "3.0.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "eslint": "9.19.0",
    "eslint-formatter-codeframe": "7.32.1",
    "eslint-plugin-format": "1.0.1",
    "husky": "^9.1.7",
    "postcss": "8.4.33",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*"
    ],
    "permissions": [
      "tabs"
    ]
  }
}
